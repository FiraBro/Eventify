# Application
APP_ENV=development
PORT=8080

# Required credentials — replace locally; never commit real secrets
DATABASE_URL=
JWT_SECRET=

# Optional integrations
REDIS_URL=localhost:6379
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# CORS: comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Request limits
MAX_REQUEST_BODY_BYTES=2097152

# Structured logging
LOG_LEVEL=info

# HTTP server timeouts
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Health checks and graceful shutdown
HEALTH_CHECK_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# SMTP — optional unless required by your enabled features
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
